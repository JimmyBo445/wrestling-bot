# Discord bot token (Discord Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_TOKEN=

# Application ID (Developer Portal -> General Information)
CLIENT_ID=

# Database address. On Railway this is linked automatically to the Postgres service.
# On your own computer use the PUBLIC address (Railway -> Postgres -> Connect -> Public Network).
DATABASE_URL=

# --- Optional ---
# Your server's ID: makes slash-command updates show up instantly in that one server.
# Leave empty to register the commands everywhere the bot is.
GUILD_ID=

# The bot registers its slash commands every time it starts. Set to false to turn that off.
AUTO_DEPLOY_COMMANDS=true

# Set to false only if your database refuses SSL connections.
# DATABASE_SSL=true
