# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Application (client) ID, same page as the token
CLIENT_ID=

# Optional: set this to instantly deploy slash commands to ONE test server
# instead of globally (global deploys take up to an hour to propagate).
# Remove/leave blank for production once you're happy with the commands.
GUILD_ID=

# Postgres connection string. Railway auto-injects this as DATABASE_URL
# when you attach a Postgres plugin to this service — you usually don't
# need to set this manually in the Railway dashboard, just locally for testing.
DATABASE_URL=postgres://user:password@localhost:5432/wrestling_bot
